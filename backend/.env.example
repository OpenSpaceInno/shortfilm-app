# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Database (MySQL 8.0)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=shortreel_user
DATABASE_PASSWORD=shortreel_password
DATABASE_NAME=shortreel_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Cache & Queues (Redis 7.0)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Identity Provider (Auth0)
AUTH0_DOMAIN=shortreel-dev.auth0.com
AUTH0_AUDIENCE=https://api.shortreel.io
AUTH0_ISSUER=https://shortreel-dev.auth0.com/
JWT_SECRET=dev_jwt_secret_must_be_at_least_32_characters_long

# Internal Webhook Shared Secrets
AUTH0_WEBHOOK_SECRET=dev_auth0_webhook_secret_key_32chars_min

# Video Infrastructure (Cloudflare Stream)
CLOUDFLARE_STREAM_ACCOUNT_ID=mock_cf_account_id
CLOUDFLARE_STREAM_API_TOKEN=mock_cf_token
CLOUDFLARE_STREAM_KEY_ID=mock_cf_key_id
CLOUDFLARE_STREAM_KEY_PEM=mock_cf_key_pem

# Payment Gateways (Stripe + Razorpay)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook
RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=mock_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=mock_razorpay_webhook_secret
