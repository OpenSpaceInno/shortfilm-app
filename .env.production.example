# ==============================================================================
# ShortReel Production Environment Template (Coolify on Hostinger VPS)
# ==============================================================================
# Paste these variables into Coolify's "Environment Variables" section.

# ------------------------------------------------------------------------------
# 1. Database Configuration (MySQL 8.0)
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change_this_to_a_strong_root_password_32chars
MYSQL_DATABASE=shortreel_prod
MYSQL_USER=shortreel_prod_user
MYSQL_PASSWORD=change_this_to_a_strong_db_password_32chars
MYSQL_PORT=3306

# ------------------------------------------------------------------------------
# 2. Redis Configuration
# ------------------------------------------------------------------------------
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. Backend API Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
BACKEND_PORT=3000
JWT_SECRET=generate_a_random_secret_with_minimum_32_characters_here
AUTO_SEED=true
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 4. Identity & Authentication (Auth0 or Custom JWT)
# ------------------------------------------------------------------------------
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.shortreel.io
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_WEBHOOK_SECRET=your_auth0_webhook_secret_key

# ------------------------------------------------------------------------------
# 5. Frontend Configuration (Vite Build Arguments)
# ------------------------------------------------------------------------------
# Leave VITE_API_URL empty if using Nginx reverse proxy on the same domain (/api)
# Or set to full API domain if separate, e.g. https://api.yourdomain.com
VITE_API_URL=
VITE_APP_TITLE=ShortReel
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_client_id
VITE_AUTH0_AUDIENCE=https://api.shortreel.io
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# 6. Video Infrastructure (Cloudflare Stream) [Optional for MVP]
# ------------------------------------------------------------------------------
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_KEY_PEM=

# ------------------------------------------------------------------------------
# 7. Payment Gateways (Stripe & Razorpay) [Optional for MVP]
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
